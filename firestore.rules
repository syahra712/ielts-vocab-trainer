rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Words collection: readable by anyone authenticated, writable only by admin SDK
    match /words/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User profile: only the owner
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Card states: only the owner
    match /users/{uid}/cardStates/{slug} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Review logs: append-only for owner
    match /users/{uid}/reviewLogs/{logId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Daily stats: only the owner
    match /users/{uid}/dailyStats/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Aggregate stats: only the owner
    match /users/{uid}/stats/{statId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
